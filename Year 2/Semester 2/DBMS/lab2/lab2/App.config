		<add key="InsertQuery" value="INSERT INTO Games (gname, gyear, pubid, mrid, grid) VALUES (@gname,@gyear,@pubid,@mrid,@grid)"/>
		<add key="DeleteQuery" value="DELETE FROM Games WHERE gid=@gid"/>
		<add key="ForeignKey" value="mrid"/>
	</appSettings>-->
	
</configuration>
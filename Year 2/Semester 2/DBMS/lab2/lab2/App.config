<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

	<connectionStrings>
		<add name="conn" connectionString="Data Source = CUMPOOTER-THE-S\SQLEXPRESS; Initial Catalog = VideoGames; Integrated Security = true;"/>
	</connectionStrings>
	
<appSettings>
		<add key="id" value="pubid"/>
		<add key="idChild" value="gid"/>
		<add key="select" value="SELECT * from Publishers"/>
		<add key="ParentTableName" value="Publishers"/>
		<add key="ChildTableName" value="Games"/>
		<add key="NumberOfColumns" value="6"/>
		<add key="ColumnNames" value="gid,gname,gyear,pubid,mrid,grid"/>
		<add key="ColumnNamesInsertParameters" value="@gid,@gname,@gyear,@pubid,@mrid,@grid"/>
		<add key="UpdateQuery" value="UPDATE Games Set grid=@grid, gname=@gname, gyear=@gyear, pubid=@pubid, mrid=@mrid WHERE gid=@gid"/>
		<add key="selectChild" value="SELECT * from Games WHERE pubid="/>
		<add key="InsertQuery" value="INSERT INTO Games (gname, gyear, pubid, mrid, grid) VALUES (@gname,@gyear,@pubid,@mrid,@grid)"/>
		<add key="DeleteQuery" value="DELETE FROM Games WHERE gid=@gid"/>
		<add key="ForeignKey" value="pubid"/>
	</appSettings>

	<!--<appSettings>
		<add key="id" value="mrid"/>
		<add key="idChild" value="gid"/>
